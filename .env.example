# VaporDrop 環境設定。複製為 .env 後修改。
# .env 已被 .gitignore 排除，切勿提交。

# ---------------------------------------------------------------------
# 網域與 WebAuthn（必改）
# ---------------------------------------------------------------------
# Caddy 監聽的站點位址。本機測試可用 localhost
SITE_ADDRESS=vapor.example.com

# WebAuthn Relying Party ID：必須等於網域本身（不含 scheme、不含 port）
RP_ID=vapor.example.com
RP_NAME=VaporDrop

# 允許的來源，逗號分隔，必須含 scheme 與（非標準）port
ORIGINS=https://vapor.example.com

# Let's Encrypt 通知信箱
ACME_EMAIL=admin@example.com

# 對外綁定；只想給 tailnet 用可設 100.x.y.z 或 127.0.0.1
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------
# Google 登入（主要登入方式）
# ---------------------------------------------------------------------
# 建置步驟：Google Cloud Console → APIs & Services → Credentials
#   → Create OAuth client ID → Web application
#   → Authorized redirect URIs 填：https://<你的網域>/auth/google/callback
# 三項都填了才會啟用 Google 登入；留空則只能用 Passkey。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# uid = HMAC(UID_PEPPER, email)。資料庫因此不存 email 原文。
# 產生方式： openssl rand -hex 32
# ⚠️ 上線後絕對不可更改，否則所有帳號會變成全新帳號。請一併備份。
UID_PEPPER=

# 白名單：逗號分隔的 email。只有列在這裡的帳號能登入。
ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com

# 或改用整個 Google Workspace 網域放行（同時作為 hd 參數）。
# 兩者可並存，任一命中即放行。留空 = 只看 ALLOWED_EMAILS。
ALLOWED_DOMAIN=

# false = handle 顯示為 g-xxxxxxxxxx（完全不可辨識，可用 cli whois 反查）
# true  = handle 用 email 的 @ 前半部（好認，但等於在 DB 留下部分個資）
STORE_EMAIL_HANDLE=false

# 預設由 ORIGINS[0] 推導，只在反向代理層改寫了網域時才需要手動指定
# GOOGLE_REDIRECT_URI=https://vapor.example.com/auth/google/callback

# 緊急登入連結（break-glass）有效秒數
RESCUE_TTL_SECONDS=600

# ---------------------------------------------------------------------
# 時間邊界（秒）
# ---------------------------------------------------------------------
CONTENT_TTL_SECONDS=600
IDLE_TIMEOUT_SECONDS=1800
INVITE_TTL_SECONDS=900
FLOW_TTL_SECONDS=300
SWEEP_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------
# 配額。注意 tmpfs 佔用的是 RAM，MAX_SESSION_BYTES x 併發數不可超過 tmpfs 大小
# ---------------------------------------------------------------------
MAX_ITEM_BYTES=33554432
MAX_SESSION_BYTES=134217728
MAX_ITEMS_PER_SESSION=50
MAX_ACTIVE_SESSIONS_PER_USER=5
MAX_TOKEN_USES=20
MAX_BODY_SIZE=34MB

# ---------------------------------------------------------------------
# 行為開關
# ---------------------------------------------------------------------
# true = 允許 session 以明文模式儲存，接收方一條 curl 即可取用，
#        代價是伺服器看得見內容。只在 tailnet 內部署時才考慮開啟。
ALLOW_SERVER_SIDE_PLAIN=false

# 首次部署允許無邀請碼註冊第一個帳號；建立後自動失效。
# 上線後建議明確設為 false。
ALLOW_FIRST_USER_BOOTSTRAP=true

# 本機以 http 測試時設 false，正式部署必須 true
COOKIE_SECURE=true

# ---------------------------------------------------------------------
# 速率限制（每分鐘）
# ---------------------------------------------------------------------
RL_AUTH_PER_MIN=10
RL_API_PER_MIN=120
RL_RAW_PER_MIN=60
